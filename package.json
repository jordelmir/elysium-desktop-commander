{
  "name": "elysium-desktop-commander",
  "version": "0.2.0",
  "private": true,
  "description": "Read-only local MCP tools with optional authenticated loopback Streamable HTTP.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "start": "node dist/server/main.js",
    "mcp": "node dist/server/main.js",
    "start:http": "node dist/server/http-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "5.0.4"
  }
}
